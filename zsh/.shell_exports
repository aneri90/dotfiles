# Common environment variables for bash and zsh

# Shell config
export LANG=en_US.UTF-8

export EDITOR=nvim
export VISUAL=nvim

# source local binaries
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.bin:$PATH"

# Add npm global bin to PATH
export PATH=~/.npm-global/bin:$PATH

# pgdump in Path without postgres (brew install libpq)
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# SDKMAN configuration
export SDKMAN_DIR="$HOME/.sdkman"

# NVM (Node Version Manager) configuration
export NVM_DIR="$HOME/.nvm"

# WSL only: point $BROWSER-aware tools (gh, gcloud, az) straight at Zen on Windows
if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    export BROWSER="$HOME/.local/bin/zen-open"
fi

# Claude Code runs its Bash tool in $SHELL (zsh) unless told otherwise, and the
# model writes bash. macOS /bin/bash is 3.2, which Claude Code refuses for
# non-trivial commands, so only bash >= 5 qualifies.
for _b in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash /bin/bash; do
    if [ -x "$_b" ] && "$_b" -c '[ "${BASH_VERSINFO[0]}" -ge 5 ]' 2>/dev/null; then
        export CLAUDE_CODE_SHELL="$_b"
        break
    fi
done
unset _b

# uv asks keyring only for an index that has a username; the variable name is
# derived from the index name in pyproject ([[tool.uv.index]] name = "gcp-repo")
export UV_INDEX_GCP_REPO_USERNAME=oauth2accesstoken
