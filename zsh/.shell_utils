# enable theprimeagen's tmux sessionizer keybinding
# bindkey -s ^t "tmux-sessionizer\n"
# my custom code navigator keybinding
bindkey -s ^f "cd \$(code-navigator)\n"

# Force a SINGLE serial gitlab.com OAuth refresh before the parallel jobs below, so they
# reuse the cached token instead of each invoking `glab auth git-credential` at once and
# racing to refresh it. That race rotates the refresh token, so all but one refresh fails
# and those git/glab calls fall back to git's `Username for 'https://gitlab.com'` prompt —
# the flood seen on the first pull of the day. Returns 0 when usable creds are available,
# 1 when a full `glab auth login` is needed (offered interactively). No-op without glab.
_glab_ensure_auth() {
  command -v glab >/dev/null || return 0
  local ans
  printf 'protocol=https\nhost=gitlab.com\n\n' | glab auth git-credential get >/dev/null 2>&1 && return 0
  print -P "%F{red}%B🔐 GitLab token expired and can't be refreshed.%b%f"
  if [[ ! -t 0 ]]; then
    print -P "   %F{8}Run %Bglab auth login%b then retry.%f"; return 1
  fi
  print -Pn "   Run %Bglab auth login%b now? [y/N] "; read -r ans
  [[ ${ans:l} == (y|yes) ]] || { print -P "   %F{8}aborted — run glab auth login then retry.%f"; return 1 }
  if glab auth login && printf 'protocol=https\nhost=gitlab.com\n\n' | glab auth git-credential get >/dev/null 2>&1; then
    print -P "   %F{green}✓ re-authenticated — continuing.%f"; return 0
  fi
  print -P "   %F{red}still not authenticated — aborting.%f"; return 1
}

# Private helper: fast-forward-pull one repo and record its result line (state\tbranch\trel).
# Records to the result file only (no stdout) so the parallel run can show a clean progress counter.
_gpull_one() {
  local repo=$1 root=$2 resultfile=$3
  local rel=${repo#$root/}; rel=${rel:-.}
  local before after state branch   # note: 'status' is a read-only special param in zsh

  branch=$(git -C "$repo" symbolic-ref --short -q HEAD) || branch='(detached)'

  if ! git -C "$repo" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    state=skip
  else
    before=$(git -C "$repo" rev-parse -q HEAD 2>/dev/null)
    if GIT_TERMINAL_PROMPT=0 git -C "$repo" pull --ff-only --autostash >/dev/null 2>&1; then
      if [[ -n $(git -C "$repo" ls-files --unmerged) ]]; then
        # ff succeeded but --autostash couldn't reapply cleanly: pull exits 0, yet the
        # tree is left conflicted (local changes are safe in the stash). Don't fake a ✅.
        state=warn
      else
        after=$(git -C "$repo" rev-parse -q HEAD 2>/dev/null)
        [[ $before != $after ]] && state=updated || state=ok
      fi
    else
      state=fail
    fi
  fi

  printf '%s\t%s\t%s\n' "$state" "$branch" "$rel" >> "$resultfile"
}

# Resolve a repo's remote (GitLab) default branch, e.g. "main"; empty if unknown.
# Prefers the cached local origin/HEAD; falls back to one network query to set it.
_gpull_default_branch() {
  local repo=$1 def
  def=$(git -C "$repo" symbolic-ref --short -q refs/remotes/origin/HEAD) \
    || { git -C "$repo" remote set-head origin -a >/dev/null 2>&1 \
         && def=$(git -C "$repo" symbolic-ref --short -q refs/remotes/origin/HEAD); }
  print -r -- "${def#origin/}"
}

# Fast-forward-pull every Git repo at or under a directory, in parallel. With no argument the
# root defaults to $HOME/gitlab-src (override with $GPULL_ROOT); pass a path to scan elsewhere
# (`gpull .` for the old current-directory behavior). Treats each repo as a leaf (won't descend
# into a repo's working tree), so heavy dirs like node_modules/target are never walked.
# Concurrency via $GPULL_JOBS (default 8; set 1 for serial).
gpull() {
  emulate -L zsh
  unsetopt monitor notify   # quiet the "[N] pid" / "[N] done" job-control noise from the & jobs
  local root=${1:-${GPULL_ROOT:-$HOME/gitlab-src}}; root=${root%/}
  local repo tmp st name branch rel abs def ans upd_note
  local -i running=0 batch=${GPULL_JOBS:-8} switch_all=0 i done_n=0 interrupted=0 header_shown=0
  local -a repos oks updated fails skips warns off_repos off_branches pids

  [[ -d $root ]] || { print -P "%F{red}gpull: $root not found.%f"; return 1 }

  # Leaf discovery: print a directory and stop descending as soon as it contains a .git
  # (dir OR file → covers normal repos, submodules and worktrees).
  while IFS= read -r -d $'\0' repo; do
    repos+=("$repo")
  done < <(find "$root" -type d -exec test -e '{}/.git' \; -prune -print0 2>/dev/null)

  (( ${#repos} )) || { print -P "%F{yellow}No git repositories under ${root/#$HOME/~}.%f"; return 0 }

  _glab_ensure_auth || return 1   # refresh the OAuth token once, serially, before going parallel

  tmp=$(mktemp "${TMPDIR:-/tmp}/gpull.XXXXXX") || return 1   # template → works on GNU + BSD/macOS
  # Ctrl+C: kill the in-flight pulls (background & jobs ignore SIGINT, so they need an explicit
  # kill), then the post-wait check below cleans up the temp file and bails. emulate -L zsh
  # already makes this trap function-local (restored on return).
  trap 'interrupted=1; (( ${#pids} )) && kill ${pids} 2>/dev/null' INT
  print -P "%B🔄 Pulling ${#repos} repos under ${root/#$HOME/~} (up to ${batch} at a time)…%b"

  for repo in "${repos[@]}"; do
    _gpull_one "$repo" "$root" "$tmp" &
    pids+=($!)
    if (( ++running >= batch )); then
      wait; running=0
      (( interrupted )) && break
      done_n=$(wc -l < "$tmp")            # done_n is `local -i` → strips wc's whitespace
      print -n "\r   pulled ${done_n}/${#repos}…"
    fi
  done
  (( interrupted )) || wait
  if (( interrupted )); then
    print -P "\n%F{yellow}⏹  gpull interrupted — $(wc -l < "$tmp" 2>/dev/null)/${#repos} done.%f"
    rm -f "$tmp"; return 130
  fi
  print "\r   pulled ${#repos}/${#repos}.   "   # final overwrite + clear, then newline

  while IFS=$'\t' read -r st branch name; do
    case $st in
      ok)      oks+=("$name") ;;
      updated) updated+=("$name"); oks+=("$name") ;;   # updated also counts as a clean pull
      warn)    warns+=("$name") ;;
      fail)    fails+=("$name") ;;
      skip)    skips+=("$name") ;;
    esac
    if [[ $branch != test && $branch != main ]]; then
      off_repos+=("$name"); off_branches+=("$branch")
    fi
  done < "$tmp"
  rm -f "$tmp"

  upd_note=''
  (( ${#updated} )) && upd_note=" (${#updated} updated)"
  print -P "\n%B── gpull: ${#oks} ok${upd_note}, ${#warns} warned, ${#skips} skipped, ${#fails} failed ──%b"
  (( ${#warns} )) && print -P "   %F{magenta}warned:%f ${(j:, :)warns}"

  # List 1 — pull errors.
  if (( ${#fails} )); then
    print -P "\n%F{red}%B✗ repos with pull errors (${#fails}):%b%f"
    for name in "${fails[@]}"; do print -P "   %F{red}•%f $name"; done
  fi

  # List 2 — not on test/main.
  if (( ${#off_repos} )); then
    print -P "\n%F{yellow}%B⎇ repos not on test/main (${#off_repos}):%b%f"
    for (( i = 1; i <= ${#off_repos}; i++ )); do
      print -P "   %F{yellow}•%f ${off_repos[i]} %F{8}(${off_branches[i]})%f"
    done
  fi

  # Offer to switch the off-branch repos to their GitLab default branch, then pull.
  (( ${#off_repos} )) || return 0
  if [[ -z $GPULL_ASSUME_YES ]] && [[ ! -t 0 ]]; then
    print -P "   %F{8}(non-interactive shell — skipping switch prompt)%f"
    return 0
  fi
  [[ -n $GPULL_ASSUME_YES ]] && switch_all=1

  for (( i = 1; i <= ${#off_repos}; i++ )); do
    (( interrupted )) && { print -P "\n%F{yellow}⏹  gpull interrupted.%f"; return 130 }
    rel=${off_repos[i]}; branch=${off_branches[i]}; abs=$root/$rel
    def=$(_gpull_default_branch "$abs")
    [[ -z $def ]]         && { print -P "   %F{8}$rel — no origin/default, skipped%f"; continue }
    [[ $def == $branch ]] && continue                 # already on default → quietly skip
    if (( ! header_shown )); then
      print -P "\n%BSwitch off-branch repos to their GitLab default branch (then pull)?%b"
      header_shown=1
    fi
    if (( ! switch_all )); then
      print -Pn "   Switch %B$rel%b ($branch → $def)? [y/N/a/q] "
      read -r ans
      (( interrupted )) && { print -P "\n%F{yellow}⏹  gpull interrupted.%f"; return 130 }
      case ${ans:l} in
        a|all)  switch_all=1 ;;
        q|quit) break ;;
        y|yes)  ;;
        *)      continue ;;
      esac
    fi
    if git -C "$abs" checkout "$def" >/dev/null 2>&1; then
      if GIT_TERMINAL_PROMPT=0 git -C "$abs" pull --ff-only --autostash >/dev/null 2>&1; then
        print -P "   %F{green}✅ $rel → $def (pulled)%f"
      else
        print -P "   %F{yellow}⚠ $rel → $def (checked out; pull failed)%f"
      fi
    else
      print -P "   %F{red}❌ $rel — checkout $def failed (uncommitted changes?)%f"
    fi
  done
}

# ── gclean: prune stale local GitLab checkouts under ~/gitlab-src ────────────────────────
# Ask GitLab (via glab) about every checkout, then offer to act: remove deleted/archived ones
# (rm -rf, guarded against losing uncommitted/unpushed/stashed work) or fix a renamed repo's
# origin URL. Env: GCLEAN_ROOT (default ~/gitlab-src), GCLEAN_JOBS (default 8),
# GCLEAN_DRY_RUN=1 or `-n` (classify only), GCLEAN_ASSUME_YES=1 (auto-confirm; still keeps
# any repo that has local work).

# origin URL → "group/.../project" on gitlab.com; non-zero if the remote isn't gitlab.com.
_gclean_project_path() {
  local url=$1
  url=${url#*://}          # strip scheme (https://) if present
  url=${url#*@}            # strip credentials / git@ user
  case $url in
    gitlab.com/*) url=${url#gitlab.com/} ;;
    gitlab.com:*) url=${url#gitlab.com:} ;;   # ssh form, just in case
    *) return 1 ;;
  esac
  print -r -- "${url%.git}"
}

# Classify one repo; append "state<TAB>work<TAB>info<TAB>rel" to $resultfile.
# state ∈ active|archived|deleted|renamed|error|foreign|noremote
_gclean_one() {
  local repo=$1 root=$2 resultfile=$3
  local rel=${repo#$root/}
  local url proj enc body archived actual msg lsout state='' info='' work=''  # NB: 'path' is a special zsh param (→ $PATH)
  local -a w

  url=$(git -C "$repo" remote get-url origin 2>/dev/null)
  [[ -z $url ]] && { printf 'noremote\037\037\037%s\n' "$rel" >> "$resultfile"; return }
  proj=$(_gclean_project_path "$url") \
    || { printf 'foreign\037\037%s\037%s\n' "$url" "$rel" >> "$resultfile"; return }
  enc=${proj//\//%2F}

  body=$(glab api "projects/$enc" 2>/dev/null)
  archived=$(jq -r '.archived' <<< "$body" 2>/dev/null)   # NB: '.archived // empty' is wrong — jq // treats false as empty
  if [[ $archived == true || $archived == false ]]; then
    actual=$(jq -r '.path_with_namespace // empty' <<< "$body" 2>/dev/null)
    if [[ -n $actual && ${actual:l} != ${proj:l} ]]; then
      state=renamed; info="https://gitlab.com/${actual}.git"     # API resolved old→new path
    elif [[ $archived == true ]]; then
      state=archived
    else
      state=active
    fi
  else
    msg=$(jq -r '.message // empty' <<< "$body" 2>/dev/null)
    if [[ $msg == *404* ]]; then
      lsout=$(GIT_TERMINAL_PROMPT=0 git -C "$repo" ls-remote origin 2>&1)
      if (( $? == 0 )); then                                     # git redirect still works → moved
        state=renamed
        info=$(print -r -- "$lsout" | sed -n 's#.*redirecting to \(https*://[^ ]*\)#\1#p' | head -1)
        info=${info%/}
      else
        state=deleted
      fi
    else
      state=error; info=$msg
    fi
  fi

  if [[ $state == archived || $state == deleted ]]; then        # only repos we might delete
    [[ -n $(git -C "$repo" status --porcelain 2>/dev/null) ]] && w+=(uncommitted)
    [[ -n $(git -C "$repo" stash list 2>/dev/null) ]] && w+=(stashed)
    [[ -n $(git -C "$repo" log --branches --not --remotes -1 --oneline 2>/dev/null) ]] && w+=(unpushed)
    work=${(j:,:)w}
  fi

  printf '%s\037%s\037%s\037%s\n' "$state" "$work" "$info" "$rel" >> "$resultfile"
}

gclean() {
  emulate -L zsh
  unsetopt monitor notify   # quiet the "[N] pid" / "[N] done" job-control noise from the & jobs
  local root=${GCLEAN_ROOT:-$HOME/gitlab-src}
  local -i dry=0 running=0 batch=${GCLEAN_JOBS:-8} n_active=0 rm_all=0 ren_all=0 done_n=0 interrupted=0
  [[ $1 == -n || $1 == --dry-run || -n $GCLEAN_DRY_RUN ]] && dry=1

  [[ -d $root ]]            || { print -P "%F{red}gclean: $root not found.%f"; return 1 }
  command -v glab >/dev/null || { print -P "%F{red}gclean: glab CLI not found.%f"; return 1 }
  command -v jq   >/dev/null || { print -P "%F{red}gclean: jq not found.%f"; return 1 }

  local repo tmp line st work info rel rec abs ans sfx
  local -a repos recs arch del ren errs foreign noremote pids

  while IFS= read -r -d $'\0' repo; do repos+=("$repo"); done \
    < <(find "$root" -type d -exec test -e '{}/.git' \; -prune -print0 2>/dev/null)
  (( ${#repos} )) || { print -P "%F{yellow}No git repositories under $root.%f"; return 0 }

  _glab_ensure_auth || return 1   # refresh the OAuth token once before the parallel glab api calls

  tmp=$(mktemp "${TMPDIR:-/tmp}/gclean.XXXXXX") || return 1
  # Ctrl+C: kill the in-flight checks (background & jobs ignore SIGINT), then bail below.
  trap 'interrupted=1; (( ${#pids} )) && kill ${pids} 2>/dev/null' INT
  print -P "%B🔎 Checking ${#repos} repos under ${root/#$HOME/~} against GitLab…%b"
  for repo in "${repos[@]}"; do
    _gclean_one "$repo" "$root" "$tmp" &
    pids+=($!)
    if (( ++running >= batch )); then
      wait; running=0
      (( interrupted )) && break
      done_n=$(wc -l < "$tmp")            # done_n is `local -i` → strips wc's whitespace
      print -n "\r   checked ${done_n}/${#repos}…"
    fi
  done
  (( interrupted )) || wait
  if (( interrupted )); then
    print -P "\n%F{yellow}⏹  gclean interrupted — $(wc -l < "$tmp" 2>/dev/null)/${#repos} checked.%f"
    rm -f "$tmp"; return 130
  fi
  print "\r   checked ${#repos}/${#repos}.   "   # final overwrite + clear, then newline

  while IFS= read -r line; do recs+=("$line"); done < "$tmp"
  rm -f "$tmp"

  for line in "${recs[@]}"; do
    IFS=$'\037' read -r st work info rel <<< "$line"
    case $st in
      active)   (( n_active++ )) ;;
      archived) arch+=("$line") ;;
      deleted)  del+=("$line") ;;
      renamed)  ren+=("$line") ;;
      error)    errs+=("$line") ;;
      foreign)  foreign+=("$line") ;;
      noremote) noremote+=("$line") ;;
    esac
  done

  print -P "\n%B── gclean: ${n_active} active, ${#del} deleted, ${#arch} archived, ${#ren} renamed ──%b"
  (( ${#noremote} + ${#foreign} + ${#errs} )) && \
    print -P "   %F{8}skipped: ${#noremote} no-origin, ${#foreign} non-gitlab, ${#errs} api-error%f"

  if (( ${#del} )); then
    print -P "\n%F{red}%B🗑  deleted — project gone (${#del}):%b%f"
    for line in "${del[@]}"; do
      IFS=$'\037' read -r st work info rel <<< "$line"
      sfx=''; [[ -n $work ]] && sfx=" %F{magenta}[$work]%f"
      print -P "   %F{red}•%f ${rel}${sfx}"
    done
  fi
  if (( ${#arch} )); then
    print -P "\n%F{yellow}%B📦 archived (${#arch}):%b%f"
    for line in "${arch[@]}"; do
      IFS=$'\037' read -r st work info rel <<< "$line"
      sfx=''; [[ -n $work ]] && sfx=" %F{magenta}[$work]%f"
      print -P "   %F{yellow}•%f ${rel}${sfx}"
    done
  fi
  if (( ${#ren} )); then
    print -P "\n%F{cyan}%B↪ renamed/moved (${#ren}):%b%f"
    for line in "${ren[@]}"; do IFS=$'\037' read -r st work info rel <<< "$line"
      print -P "   %F{cyan}•%f $rel %F{8}→ ${info:-<new path unknown>}%f"; done
  fi
  if (( ${#errs} )); then
    print -P "\n%F{8}%Bapi-errors (${#errs}) — not classified:%b%f"
    for line in "${errs[@]}"; do IFS=$'\037' read -r st work info rel <<< "$line"
      print -P "   %F{8}• $rel — ${info}%f"; done
  fi

  # ── actions ────────────────────────────────────────────────────────────────
  (( ${#del} + ${#arch} + ${#ren} )) || return 0
  if (( dry )); then print -P "\n%F{8}(dry-run — no changes made)%f"; return 0; fi
  if [[ -z $GCLEAN_ASSUME_YES && ! -t 0 ]]; then
    print -P "\n%F{8}(non-interactive — re-run in a terminal to act)%f"; return 0
  fi
  [[ -n $GCLEAN_ASSUME_YES ]] && { rm_all=1; ren_all=1 }

  if (( ${#del} + ${#arch} )); then
    print -P "\n%B🔥 Remove stale checkouts (rm -rf)?%b"
    for rec in "${del[@]}" "${arch[@]}"; do
      IFS=$'\037' read -r st work info rel <<< "$rec"; abs=$root/$rel
      [[ $abs == $root/* && -d $abs ]] || { print -P "   %F{8}$rel — skipped (path guard)%f"; continue }
      if [[ -n $work ]]; then            # local work → always confirm individually, default No
        print -Pn "   %F{magenta}⚠ $rel has local work [$work]%f — rm -rf anyway? [y/N] "
        read -r ans
        (( interrupted )) && { print -P "\n%F{yellow}⏹  gclean interrupted.%f"; return 130 }
        [[ ${ans:l} == (y|yes) ]] || { print -P "   %F{8}$rel — kept%f"; continue }
      elif (( ! rm_all )); then
        print -Pn "   rm -rf %B$rel%b ($st)? [y/N/a/q] "; read -r ans
        (( interrupted )) && { print -P "\n%F{yellow}⏹  gclean interrupted.%f"; return 130 }
        case ${ans:l} in a|all) rm_all=1 ;; q|quit) break ;; y|yes) ;; *) continue ;; esac
      fi
      if rm -rf -- "$abs"; then print -P "   %F{green}✅ removed $rel%f"
      else print -P "   %F{red}❌ failed to remove $rel%f"; fi
    done
  fi

  if (( ${#ren} )); then
    print -P "\n%B🔗 Fix origin URL of renamed repos?%b"
    for rec in "${ren[@]}"; do
      IFS=$'\037' read -r st work info rel <<< "$rec"; abs=$root/$rel
      [[ -z $info ]] && { print -P "   %F{8}$rel — new path unknown, skipped%f"; continue }
      if (( ! ren_all )); then
        print -Pn "   set origin of %B$rel%b → $info ? [y/N/a/q] "; read -r ans
        (( interrupted )) && { print -P "\n%F{yellow}⏹  gclean interrupted.%f"; return 130 }
        case ${ans:l} in a|all) ren_all=1 ;; q|quit) break ;; y|yes) ;; *) continue ;; esac
      fi
      if git -C "$abs" remote set-url origin "$info"; then print -P "   %F{green}✅ $rel origin → $info%f"
      else print -P "   %F{red}❌ $rel — failed to set origin%f"; fi
    done
  fi
}